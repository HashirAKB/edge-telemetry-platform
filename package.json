{
  "name": "edge-telemetry-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Edge-to-cloud industrial telemetry platform on AWS (reference build)",
  "license": "MIT",
  "author": "Hashir Ahmed K B",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "synth": "pnpm -F @etp/infra run synth",
    "sim:local": "pnpm -F @etp/simulator run start:local",
    "smoke": "pnpm -F @etp/scripts run smoke",
    "teardown": "pnpm -F @etp/scripts run teardown",
    "device:provision": "pnpm -F @etp/scripts run device:provision",
    "device:deprovision": "pnpm -F @etp/scripts run device:deprovision",
    "device:check-policy": "pnpm -F @etp/scripts run device:check-policy",
    "check:ingest": "pnpm -F @etp/scripts run check:ingest",
    "openapi": "pnpm -F @etp/scripts run openapi",
    "openapi:check": "pnpm -F @etp/scripts run openapi:check",
    "edge:publish-image": "pnpm -F @etp/scripts run edge:publish-image",
    "edge:status": "pnpm -F @etp/scripts run edge:status",
    "edge:outage-test": "pnpm -F @etp/scripts run edge:outage-test",
    "edge:fault": "pnpm -F @etp/scripts run edge:fault",
    "edge:deprovision": "pnpm -F @etp/scripts run edge:deprovision",
    "monitor:on": "pnpm -F @etp/scripts run monitor:on",
    "monitor:off": "pnpm -F @etp/scripts run monitor:off"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
