{
  "name": "@etp/simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Industrial sensor simulator (Greengrass Docker component)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@etp/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start:local": "tsx --conditions=@etp/source src/main.ts",
    "bundle": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --conditions=@etp/source --external:aws-iot-device-sdk-v2 --sourcemap --outfile=bundle/main.mjs"
  },
  "dependencies": {
    "@etp/shared": "workspace:*",
    "aws-iot-device-sdk-v2": "1.28.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
