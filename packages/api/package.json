{
  "name": "@etp/api",
  "version": "0.1.0",
  "private": true,
  "description": "Telemetry query API Lambda services",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@etp/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.36.0",
    "@aws-lambda-powertools/metrics": "2.36.0",
    "@aws-lambda-powertools/tracer": "2.36.0",
    "@aws-sdk/client-iotsitewise": "3.1148.0",
    "@etp/shared": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164"
  }
}
