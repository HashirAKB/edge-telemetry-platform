{
  "name": "@etp/scripts",
  "version": "0.1.0",
  "private": true,
  "description": "Operational scripts: dev device, ingest checks",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "device:provision": "tsx --conditions=@etp/source provision-dev-device.ts",
    "device:deprovision": "tsx --conditions=@etp/source deprovision-dev-device.ts",
    "device:check-policy": "tsx --conditions=@etp/source check-device-policy.ts",
    "check:ingest": "tsx --conditions=@etp/source check-ingest.ts",
    "openapi": "tsx --conditions=@etp/source generate-openapi.ts",
    "openapi:check": "tsx --conditions=@etp/source generate-openapi.ts --check",
    "smoke": "tsx --conditions=@etp/source smoke.ts",
    "edge:publish-image": "tsx --conditions=@etp/source publish-simulator-image.ts",
    "edge:status": "tsx --conditions=@etp/source edge-status.ts",
    "edge:outage-test": "tsx --conditions=@etp/source outage-test.ts",
    "edge:fault": "tsx --conditions=@etp/source edge-fault.ts",
    "edge:deprovision": "tsx --conditions=@etp/source deprovision-edge-core.ts",
    "monitor:on": "tsx --conditions=@etp/source monitor-toggle.ts on",
    "monitor:off": "tsx --conditions=@etp/source monitor-toggle.ts off"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "3.1148.0",
    "@aws-sdk/client-cloudformation": "3.1148.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1148.0",
    "@aws-sdk/client-ecr": "3.1148.0",
    "@aws-sdk/client-greengrassv2": "3.1148.0",
    "@aws-sdk/client-iot": "3.1148.0",
    "@aws-sdk/client-iotsitewise": "3.1148.0",
    "@aws-sdk/client-scheduler": "3.1148.0",
    "@aws-sdk/client-ssm": "3.1148.0",
    "@aws-sdk/client-sts": "3.1148.0",
    "@etp/shared": "workspace:*",
    "@etp/simulator": "workspace:*",
    "yaml": "2.9.1"
  }
}
